# .env.example - Variables de entorno (plantilla)
# Copia este archivo a .env y completa con valores reales
# NUNCA versionéis .env - está en .gitignore

# === APLICACIÓN ===
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# === BASE DE DATOS ===
# PostgreSQL es la única base principal del proyecto.
# La contraseña se solicita de forma interactiva; no se guarda aquí.
PGHOST=localhost
PGPORT=5432
PGDATABASE=perfect_catalog_dev
PGUSER=perfect_catalog_app

# === ODOO ===
ODOO_SOURCE=manual  # manual | api (TBD)
ODOO_EXCEL_PATH=data/imports/natsuki_productos.xlsx
ODOO_CSV_PATH=data/imports/natsuki_productos.csv

# === DIRECTORIOS ===
DATA_IMPORTS_DIR=data/imports
DATA_IMAGES_DIR=data/images
DATA_EXPORTS_DIR=data/exports
LOGS_DIR=logs
BACKUPS_DIR=backups

# === IMAGENES ===
IMAGES_PRESERVE_ORIGINALS=True  # Nunca modificar imágenes originales
IMAGES_MAX_SIZE_MB=50
IMAGES_ALLOWED_FORMATS=jpg,jpeg,png,gif,webp

# === CATALOGO ===
CATALOG_BRAND=natsuki  # natsuki | perfect | (otras)
CATALOG_LANGUAGE=es
CATALOG_CURRENCY=USD

# === INDESIGN (Fase posterior) ===
INDESIGN_TEMPLATES_DIR=templates/indesign
INDESIGN_SNAPSHOTS_DIR=data/indesign_snapshots
INDESIGN_TEMPLATE_T4=true
INDESIGN_TEMPLATE_T2=true
INDESIGN_TEMPLATE_T1=true
INDESIGN_TEMPLATE_TABLE=true
INDESIGN_TEMPLATE_SEPARATOR=true

# === PDF ===
PDF_OUTPUT_DIR=data/exports/pdf
PDF_COMPRESSION=True

# === WEB / API ===
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_CORS_ORIGINS=127.0.0.1:8080,localhost:8080

# === SEGURIDAD ===
# El modo operador genera su clave de sesión en memoria y solicita por consola
# el actor y un código temporal. No guardar esos valores en .env.

# === DESARROLLO ===
RELOAD_ON_CHANGE=True
MOCK_DATA=False
